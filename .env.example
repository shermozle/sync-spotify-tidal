# ── Spotify ─────────────────────────────────────────────────────────────────
# Register a free app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Bare playlist ID — from the Spotify URL:
#   https://open.spotify.com/playlist/<SPOTIFY_PLAYLIST_ID>
SPOTIFY_PLAYLIST_ID=

# ── Tidal ────────────────────────────────────────────────────────────────────
# No developer registration needed — just a regular Tidal account.
# Run the script once; it will print a URL to visit in your browser.
# The session is then saved to tidal_session.json for future non-interactive runs.
#
# Tidal playlist UUID — visible in the Tidal app URL or share link.
TIDAL_PLAYLIST_ID=

# ── Resend ───────────────────────────────────────────────────────────────────
# https://resend.com — free tier covers this use case
RESEND_API_KEY=
RESEND_FROM=sync@yourdomain.com
RESEND_TO=you@yourdomain.com

# ── Optional ─────────────────────────────────────────────────────────────────
LOG_DIR=./logs

# ── GitHub Actions (do not set locally) ─────────────────────────────────────
# After your first local run, copy the contents of .cache and tidal_session.json
# into GitHub repository secrets named SPOTIFY_CACHE and TIDAL_SESSION.
# The script writes these to disk at startup when running on CI.
# SPOTIFY_CACHE=
# TIDAL_SESSION=
